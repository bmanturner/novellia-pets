DATABASE_URL=.data/app.db
# Migrate and seed an empty database on first connection (for hosts without a
# persistent disk, e.g. Vercel with DATABASE_URL=/tmp/app.db).
DATABASE_BOOTSTRAP=false

# Chat agent (optional). Leave empty to disable chat.
ANTHROPIC_API_KEY=
# Optional Claude model id (default claude-haiku-5-5).
ANTHROPIC_MODEL=
